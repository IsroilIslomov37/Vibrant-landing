# --- Admin panel -------------------------------------------------------------
# Password for /admin. Change this before deploying.
ADMIN_PASSWORD=vibrant2026
# HMAC key for session cookies. Must be >= 16 chars; required in production.
ADMIN_SECRET=change-me-to-a-long-random-string

# --- Storage -----------------------------------------------------------------
# Where site.json and leads.json live. Defaults to ./data
# On serverless hosts, point this at a mounted volume or swap src/lib/store.ts.
# VIBRANT_DATA_DIR=./data

# --- Lead notifications (all optional) ---------------------------------------
# Enable the Telegram channel in Admin -> Settings, then set both values:
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=-1001234567890

# Any endpoint that accepts { type: "lead.created", lead: {...} }
# LEAD_WEBHOOK_URL=https://hooks.example.com/vibrant-leads

# --- Metadata ----------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://vibrant.school

# --- Vercel note --------------------------------------------------------------
# Vercel's filesystem is read-only, so the JSON store cannot persist there.
# The landing page and the lead form still work (leads go to Telegram), but the
# admin panel returns 503 on save and the Leads tab stays empty.
# Set TELEGRAM_* below before going live, or swap src/lib/store.ts for a database.
